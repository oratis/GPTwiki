# NextAuth
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Secret for the admin-only seed endpoints (/api/seed, /api/seed/wikipedia).
# Send it as `Authorization: Bearer <SEED_SECRET>` or `x-seed-secret`.
# Falls back to AUTH_SECRET if unset, but configure a distinct value in prod.
SEED_SECRET=your-seed-secret-here

# Encrypts user-provided provider API keys at rest (AES-256-GCM).
# If unset, keys are stored in plaintext (a warning is logged). Set a strong
# random value in production (`openssl rand -base64 32`). Rotating this value
# makes previously-encrypted keys undecryptable, so users would re-enter them.
API_KEY_ENCRYPTION_SECRET=your-encryption-secret-here

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# GitHub OAuth
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Resend (for email magic-link sign-in). Create at https://resend.com
# and verify the sending domain before going to production.
AUTH_RESEND_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM=no-reply@gptwiki.net

# Firebase Admin
FIREBASE_PROJECT_ID=gptwiki
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="your-private-key"

# AI API Keys (users select which model to use)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Free tier: platform-keyed AI messages per signed-in user per day.
# Off by default (0 = BYOK-only); set a positive number to enable.
FREE_DAILY_MESSAGES=0
# Account whose platform-key usage is never metered (project owner).
# No default — leave blank and nobody is exempt. Set it to an address you
# control; it spends this deployment's provider keys without any quota.
PLATFORM_OWNER_EMAIL=

# Arena: platform-funded battles per signed-in user per day. Separate meter from
# chat and off by default for the same reason — one battle is TWO generations,
# so drawing on platform keys is a decision the operator makes explicitly.
# At 0, a battle requires the user to hold API keys for two different providers
# (the owner account above is exempt and always uses platform keys). This is the
# switch that decides whether the arena is reachable by anyone but you.
ARENA_FREE_DAILY_BATTLES=0

# Arena: platform-funded battles per day for visitors who are NOT signed in.
# Off by default — this is the one path that spends provider keys with no
# account in front of it, so opening it is an explicit operator decision.
#
# Metered per client address (a salted hash of it; raw IPs are never stored),
# because the per-browser cookie that identifies an anonymous voter is one click
# away from being reset and so cannot bound a bill. Anonymous votes are recorded
# with weight 0 and never reach the leaderboard, so opening this cannot distort
# the ratings — it only costs tokens.
#
# Sizing: one battle is TWO generations. Set this to the number of battles you
# are willing to fund per address per day, e.g. 2.
ARENA_ANON_DAILY_BATTLES=0

# Platform-wide ceiling on FREE generations per UTC day — the backstop none of
# the three meters above can be. Each of those bounds one identity (a user, an
# address); none bounds how many identities show up, and every anonymous arena
# battle spends a platform key by definition.
#
# Counted in generations, because the meters disagree on what a unit is: a chat
# message is one, an arena battle is two.
#
# UNSET OR EMPTY MEANS NO CAP — deliberately not the 0-means-off convention of
# the variables above. Those gate free tiers that ship off; this one would gate
# a free tier that may already be running, so leaving it blank must change
# nothing. An explicit 0 does mean "no free generations today".
#
# This is a runtime env var: arm it on an existing deployment without a rebuild,
#   gcloud run services update <service> --update-env-vars FREE_GLOBAL_DAILY_GENERATIONS=2000
FREE_GLOBAL_DAILY_GENERATIONS=

# Arena: per-model token prices, powering the "rating vs cost" (Pareto) view on
# /arena/leaderboard. JSON, USD per million tokens, keys `in` and `out`. Unset
# means no cost axis and an empty Pareto tab — the view says "not configured"
# rather than guessing, because a wrong chart still looks like a chart. Every
# model is optional; unknown keys are rejected and the whole table ignored.
# Blended cost weights output 3:1 over input.
# ARENA_MODEL_PRICING='{"claude":{"in":3,"out":15},"gpt":{"in":2.5,"out":10},"gemini":{"in":0.1,"out":0.4}}'
ARENA_MODEL_PRICING=

# Seedream (Volcengine Ark) for image generation — used by scripts/seed-rich.ts
ARK_API_KEY=your-ark-api-key

# GCS bucket for wiki images (public read) — used by scripts/seed-rich.ts
GCS_WIKI_IMAGES_BUCKET=gptwiki-images

# Google Analytics 4 measurement id (optional — no analytics when unset).
# BUILD-TIME ONLY: Next inlines NEXT_PUBLIC_* during `next build`, so setting
# this on a running container does nothing. For a container build pass it as
# `--build-arg NEXT_PUBLIC_GA_ID=G-XXXXXXX` (cloudbuild.yaml exposes it as the
# `_GA_ID` substitution). There is no default: leave it blank and gtag never
# loads. Note the app currently ships no consent gate and no privacy policy
# page, so enabling this in a jurisdiction that requires either is on you.
NEXT_PUBLIC_GA_ID=

# Typesense search (optional — falls back to Firestore keyword search when unset)
# See docs/typesense.md for provisioning and bootstrap.
TYPESENSE_HOST=
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# SEO emergency switch: noindex every Wikipedia mirror page (source: wikipedia-*)
# at once. Off by default (mirrors stay indexed). Set to 1/true/yes only if Google
# flags the site for scaled-content abuse. On Cloud Run this is a service env var
# (gcloud run services update gptwiki --update-env-vars NOINDEX_WIKIPEDIA_MIRRORS=true),
# no rebuild needed; prerendered pages lag up to their revalidate window.
NOINDEX_WIKIPEDIA_MIRRORS=false
