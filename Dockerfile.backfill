FROM node:20-alpine

WORKDIR /app

# tsx + firebase-admin + @google-cloud/storage + dotenv pulled from
# package.json. Slim image: no Next.js build, no dev hooks.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

COPY tsconfig.json ./
COPY scripts/backfill-wiki-images.ts ./scripts/
COPY src/lib/gcs.ts ./src/lib/

# Cloud Run sets CLOUD_RUN_TASK_INDEX / CLOUD_RUN_TASK_COUNT; the script
# reads those to derive its shard. The script also bumps undici's
# global Agent to 64 connections-per-origin, so --concurrency=32 can
# actually saturate fetches on IP-clean tasks (defaults to 10
# otherwise). Throttled IPs are 429-bounded regardless.
CMD ["npx", "tsx", "scripts/backfill-wiki-images.ts", "--apply", "--concurrency=32"]
